// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===============================================
// UNCHANGED CORE MODELS
// ===============================================
model Jurisdiction {
  id               String            @id @default(cuid())
  name             String
  currency         String
  locale           String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenants          Tenant[]
  taxBrackets      TaxBracket[]
  calcSteps        CalculationStep[]
  salaryComponents SalaryComponent[]
}

model TaxBracket {
  id             String       @id @default(cuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  year           Int
  incomeMin      Decimal
  incomeMax      Decimal?
  rate           Decimal
  flatDeduction  Decimal
}

model CalculationStep {
  id                String       @id @default(cuid())
  jurisdictionId    String
  jurisdiction      Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  name              String       // e.g., "Calculate Taxable Gross"
  executionOrder    Int          // The order to run this step in
  targetComponentId String?      // Optional: The SalaryComponent this step calculates (e.g., CNSS component ID)
  targetContextKey  String       // The key in the runtime context to store the result, e.g., "grossPay", "taxableIncome", "cnssAmount"
  formula           String       // e.g., "SUM(EARNINGS)", "MIN(taxableIncome, 6000) * 0.0448"
  baseContextKeys   String[]     // Input keys from the context needed for this formula, for dependency tracking

  @@unique([jurisdictionId, executionOrder])
  @@unique([jurisdictionId, targetContextKey])
}


// ===============================================
// MODIFIED MODELS (as per request)
// ===============================================

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  firstName    String
  lastName     String
  passwordHash String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenants      UserTenantAccess[]
  payrollRuns  PayrollRun[]       @relation("ProcessedByUser")
}

model Tenant {
  id               String                  @id @default(uuid())
  name             String
  schemaName       String                  @unique
  status           String                  @default("active")
  jurisdictionId   String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  jurisdiction     Jurisdiction            @relation(fields: [jurisdictionId], references: [id])
  users            UserTenantAccess[]
  roles            Role[]
  departments      Department[]
  employees        Employee[]
  paySchedules     PaySchedule[]
  salaryComponents SalaryComponent[]
  salarySettings   EmployeeSalarySetting[]
  payrollRuns      PayrollRun[]
  payslips         Payslip[]
  payslipItems     PayslipItem[]
}

model Role {
  id          String             @id @default(uuid())
  name        String // e.g., 'admin', 'hr_manager', 'viewer'
  description String?
  tenantId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt // <<< FIX APPLIED HERE
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserTenantAccess[]

  @@unique([tenantId, name]) // A role name should be unique within a tenant
}


// ===============================================
// NEW MODEL (as per request)
// ===============================================
// This is the heart of the new multi-tenant access system.
model UserTenantAccess {
  userId    String
  tenantId  String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict) // Don't allow a Role to be deleted if it's assigned to a user
  createdAt DateTime @default(now())

  // A user can only have one entry (and thus one role) per tenant.
  @@id([userId, tenantId])
}


// ===============================================
// REMOVED MODEL (as per request)
// ===============================================

// model UserRole { ... } was deleted.


// ===============================================
// UNCHANGED MODELS
// ===============================================

model SalaryComponent {
  id                     String                  @id @default(cuid())
  name                   String
  description            String?
  type                   String // 'earning', 'deduction', 'tax'
  calculationType        String // 'fixed', 'percentage', 'formula'
  amount                 Decimal?
  percentage             Decimal?
  isTaxable              Boolean                 @default(false)
  isActive               Boolean                 @default(true)
  isSystemDefined        Boolean                 @default(false)
  payslipDisplayOrder    Int?
  category               String? // 'employee_earning', 'employer_contribution' etc.
  tenantId               String?
  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id])
  jurisdictionId         String?
  jurisdiction           Jurisdiction?           @relation(fields: [jurisdictionId], references: [id])
  employeeSalarySettings EmployeeSalarySetting[]
  payslipItems           PayslipItem[]
}

model Department {
  id          String     @id @default(cuid())
  name        String
  description String?
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  employees   Employee[]

  @@unique([tenantId, name])
}

model Employee {
  id              String                  @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  jobTitle        String
  hireDate        DateTime
  terminationDate DateTime?
  status          String                  @default("active")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  departmentId    String?
  department      Department?             @relation(fields: [departmentId], references: [id])
  salarySettings  EmployeeSalarySetting[]
  payslips        Payslip[]
  dependents      Dependent[]

  @@unique([tenantId, email])
}

model Dependent {
  id         String   @id @default(cuid())
  fullName   String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model EmployeeSalarySetting {
  id                String          @id @default(cuid())
  amount            Decimal?
  percentage        Decimal?
  effectiveDate     DateTime
  isActive          Boolean         @default(true)
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])
  salaryComponentId String
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@unique([employeeId, salaryComponentId])
}

model PaySchedule {
  id          String       @id @default(cuid())
  name        String
  frequency   String // 'monthly', 'weekly', 'bi-weekly'
  isActive    Boolean      @default(true)
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  payrollRuns PayrollRun[]

  @@unique([tenantId, name])
}

model PayrollRun {
  id                String      @id @default(cuid())
  periodStart       DateTime
  periodEnd         DateTime
  paymentDate       DateTime
  status            String // 'processing', 'completed', 'paid'
  notes             String?
  totalGrossPay     Decimal?    @default(0)
  totalDeductions   Decimal?    @default(0)
  totalNetPay       Decimal?    @default(0)
  totalEmployees    Int?        @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  payScheduleId     String
  paySchedule       PaySchedule @relation(fields: [payScheduleId], references: [id])
  processedByUserId String?
  processedByUser   User?       @relation("ProcessedByUser", fields: [processedByUserId], references: [id])
  payslips          Payslip[]
}

model Payslip {
  id           String        @id @default(cuid())
  grossPay     Decimal
  deductions   Decimal
  taxes        Decimal
  netPay       Decimal
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  payrollRunId String
  payrollRun   PayrollRun    @relation(fields: [payrollRunId], references: [id])
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id])
  payslipItems PayslipItem[]
}

model PayslipItem {
  id                String          @id @default(cuid())
  description       String
  type              String // 'earning', 'deduction', 'tax'
  amount            Decimal
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  payslipId         String
  payslip           Payslip         @relation(fields: [payslipId], references: [id])
  salaryComponentId String?
  salaryComponent   SalaryComponent? @relation(fields: [salaryComponentId], references: [id])
}